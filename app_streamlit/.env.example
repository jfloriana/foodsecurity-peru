# Copie este archivo a .env y complete los valores. NO versione .env.
POSTGRES_DB=fsai
POSTGRES_USER=fsai_admin
# Obligatoria. Use una clave larga y aleatoria; si contiene caracteres especiales
# (@ : / ? # %), codifíquela como porcentaje porque se inserta en la URL de conexión.
POSTGRES_PASSWORD=

# Usuarios de la aplicación: lista JSON generada con "python app/auth.py" (una ejecución por usuario).
# Formato: [{"usuario":"<texto>","rol":"admin|analista|lector","salt":"<hex>","iteraciones":600000,"hash":"<hex>"}]
FSAI_USUARIOS=

# Opcionales
FSAI_APP_PORT=8501
FSAI_SESION_MIN=60
FSAI_CACHE_TTL=300
# Mapa coroplético: ruta dentro del contenedor (p. ej. /app/geo/departamentos.geojson) [POR VALIDAR: fuente]
FSAI_GEOJSON_DEPARTAMENTOS=
FSAI_GEOJSON_CLAVE=NOMBDEP
